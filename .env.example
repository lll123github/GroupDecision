# 本地浏览器访问 http://localhost:18760
PORT=18760
BIND_ADDRESS=127.0.0.1

# 直接 HTTP 本地测试保持为 0；在 HTTPS 反向代理后运行时设为 1。
SECURE_COOKIE=0

# 可选：构建基础镜像。镜像拉取缓慢时可换成可访问的镜像仓库。
RUST_IMAGE=rust:1.99.1-bookworm
RUNTIME_IMAGE=debian:bookworm-slim

# 默认使用 Cargo 镜像；将此值留空可改用 crates.io。
CARGO_REGISTRY_MIRROR=https://rsproxy.cn/index/
